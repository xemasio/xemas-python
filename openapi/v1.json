    "/v1/entity/{address}/history": {
      "get": {
        "description": "Resolution history: the last 20 snapshots recorded for this address, newest\nfirst. Each entry shows which entity_id was resolved, which policy version ran,\nwhen it resolved, and how many identity claims contributed. Useful for auditing\nhow an identity evolved over time (e.g. after a new curated row is added).\nRequires `Authorization: Bearer sk-xemas-<key>`.",
        "operationId": "v1_entity_history_v1_entity__address__history_get",
        "parameters": [
          {
            "in": "path",
