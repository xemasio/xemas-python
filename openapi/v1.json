  "info": {
    "description": "Authenticated (Authorization: Bearer sk-xemas-<key>) read access to on-chain entity, behaviour, counterparty, portfolio, fund-flow, whale, and contract intelligence.",
    "title": "XemaS Semantic Intelligence API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/behaviour/{address}": {
      "get": {
        "description": "Behaviour Intelligence: how does this actor behave? Returns the canonical\nBehaviourProfile (every family present; unmeasured families carry their\nreason) wrapped in the v1 envelope. Requires `Authorization: Bearer\nsk-xemas-<key>`; per-key rate limit applies.",
        "operationId": "v1_behaviour_v1_behaviour__address__get",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "title": "Address",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "chain_id",
            "required": false,
            "schema": {
              "default": 1,
              "title": "Chain Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "V1 Behaviour",
        "tags": [
          "Semantic Intelligence API v1",
          "Semantic Intelligence API v1"
        ]
      }
    },
    "/v1/contract/{address}": {
      "get": {
        "description": "Contract Intelligence: is the code dangerous? Returns the latest completed\ncanonical scan's contract intelligence - a banded verdict (LOW / MODERATE /\nHIGH / CRITICAL, never SAFE), the canonical contract view, and the canonical\nevidence envelope (verification states + coverage) - wrapped in the v1\nenvelope. When the address has no completed scan, returns 200 with\nstate=\"not_scanned\" and verdict=null (absence is stated, never fabricated).\nWhen the scan's ai_insights carry a governed AI analysis (row 9's\nsolana_scan_ai_insights surface), the response also carries a\n`governance_metadata` envelope slot (gap H10) - omitted entirely for scans\nwith no governed AI-derived content. This endpoint reads; it does not launch\nscans. Requires `Authorization: Bearer sk-xemas-<key>`; per-key rate limit\napplies.",
        "operationId": "v1_contract_v1_contract__address__get",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "title": "Address",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "chain_id",
            "required": false,
            "schema": {
              "default": 1,
              "title": "Chain Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "V1 Contract",
        "tags": [
          "Semantic Intelligence API v1",
          "Semantic Intelligence API v1"
        ]
      }
    },
    "/v1/counterparties/{address}": {
      "get": {
        "description": "Counterparty Intelligence: who does this actor transact with? Returns the\ncanonical CounterpartyProfile - attributed counterparties with per-attribution\nevidence, exposure, and coverage - wrapped in the v1 envelope. Requires\n`Authorization: Bearer sk-xemas-<key>`; per-key rate limit applies.",
        "operationId": "v1_counterparties_v1_counterparties__address__get",
        "parameters": [
          {
            "in": "path",
            "name": "address",
            "required": true,
            "schema": {
              "title": "Address",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "chain_id",
            "required": false,
            "schema": {
              "default": 1,
              "title": "Chain Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "V1 Counterparties",
        "tags": [
          "Semantic Intelligence API v1",
          "Semantic Intelligence API v1"
        ]
      }
    },
